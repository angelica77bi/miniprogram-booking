/* pages/booking/booking.wxss */
.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-main);
}

.calendar-card {
  background-color: #ffffff;
  border-radius: var(--border-radius);
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.month-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
}

.nav-btn {
  padding: 10rpx 30rpx;
  color: var(--primary-color);
  font-size: 32rpx;
  font-weight: bold;
}

.week-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 20rpx;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  /* 🚨 改为垂直排列，为了让“已满”文字在日期下方 */
  flex-direction: column; 
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  border-radius: 50%;
  transition: all 0.2s;
}

.empty {
  background: transparent;
}

.selectable {
  color: var(--text-main);
  background-color: #f0f0f0;
}

.selectable:active {
  background-color: var(--primary-color);
  color: #ffffff;
  transform: scale(0.9);
}

.disabled {
  color: #cccccc;
  background-color: transparent;
}

/* 🚨 新增满房样式覆盖 */
.full-day {
  background-color: #f5f5f5 !important;
  color: #999999 !important;
}

.full-day:active {
  transform: scale(0.9);
  /* 覆盖原本的点击高亮颜色，防止点击已满日期时变绿 */
  background-color: #e0e0e0 !important; 
}

.full-text {
  font-size: 20rpx;
  color: #ff4d4f; /* 红色字提示已满 */
  line-height: 1;
  margin-top: 4rpx;
}

.tips {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.5;
}