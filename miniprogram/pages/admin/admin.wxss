/* pages/admin/admin.wxss */
.admin-container {
  padding: 30rpx;
  background-color: #f6f7f9;
  min-height: 100vh;
}

.admin-header {
  margin-bottom: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.admin-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #2c3e50;
}

.admin-count {
  font-size: 26rpx;
  color: #7f8c8d;
}

.no-data {
  text-align: center;
  color: #95a5a6;
  margin-top: 150rpx;
  font-size: 28rpx;
}

/* --- 卡片基础样式 --- */
.order-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* 三行之间的间距 */
}

/* --- 第一行：时间与状态 --- */
.card-row-1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx dashed #ecf0f1;
  padding-bottom: 20rpx;
}

.order-date {
  font-size: 34rpx;
  font-weight: 800;
  color: #2c3e50;
}
.order-status {
  /* ✨ 核心居中逻辑 */
  display: flex;
  justify-content: center;
  align-items: center;
  
  /* ✨ 细节修正：强制行高为 1，防止不同设备默认行高导致的文字偏上或偏下 */
  line-height: 1; 
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-weight: 500;
  
  /* 如果你希望所有状态卡片的最小宽度一致（看起来更整齐），可以加这一行 */
  min-width: 80rpx; 
}
/* 状态动态颜色 */
.status-1 { color: #27ae60; background: #e8f8f5; } /* 已确认 */
.status--1 { color: #e74c3c; background: #fdedec; } /* 已取消 */
.status-0 { color: #cd33be; background: #fef5e7; }  /* 待处理 */


/* --- 第二行：客户详情 --- */
.card-row-2 {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 元素之间的间隔 */
}

.customer-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #34495e;
}

.guest-count {
  font-size: 28rpx;
  color: #7f8c8d;
}

.customer-phone {
  font-size: 22rpx; /* 满足需求：联系方式字体较小 */
  color: #bdc3c7;
  letter-spacing: 1rpx;
}

.activity-tag {
  margin-left: auto; /* 自动推到最右侧 */
  font-size: 24rpx;
  color: #2980b9;
  background: #ebf5fb;
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-weight: 500;
}


/* --- 第三行：操作按钮组 --- */
.card-row-3 {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f1f2f6;
}

/* 📞 电话 Emoji 小卡片 */
.call-btn-card {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f2f6;
  border-radius: 16rpx;
  width: 76rpx;
  height: 76rpx;
  font-size: 38rpx;
  transition: all 0.2s;
}
.call-btn-card:active {
  background: #e1e3e8;
  transform: scale(0.95);
}

/* 确认/取消 按钮容器 */
.action-buttons {
  flex: 1;
  display: flex;
  gap: 20rpx;
  align-items: center;
}

/* ！！！对抗微信原生 button 样式的核武器 ！！！ */
.action-btn {
  margin: 0 !important;
  padding: 0 !important;
  height: 76rpx !important;
  border-radius: 16rpx !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  font-size: 28rpx !important;
  font-weight: bold !important;
}

/* 干掉微信默认的丑边框 */
.action-btn::after {
  border: none !important;
}

/* ✅ 确认接单：撑满剩余所有空间 */
.action-btn.confirm {
  flex: 1 !important;
  width: 100% !important; /* 强制覆盖微信的默认定宽 */
  background-color: #f1f2f6 !important; 
  color: #333333 !important; 
}

/* ❌ 取消订单：红底白字，只比 4 个字宽一点点 */
.action-btn.cancel {
  flex-shrink: 0 !important;
  width: 160rpx !important; /* 直接强制设定为一个微小的宽度 */
  background-color: #e02629 !important; /* 你要的红色背景 */
  color: #ffffff !important; /* 白色文字 */
}