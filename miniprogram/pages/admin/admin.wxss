/* pages/admin/admin.wxss */
.admin-container {
  padding: 30rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.admin-header {
  margin-bottom: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.admin-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.admin-count {
  font-size: 24rpx;
  color: #666;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.order-info-row {
  display: flex;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.order-date {
  font-weight: bold;
  color: #007AFF;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #fff7e6;
  color: #fa8c16;
}

.order-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.customer-name {
  font-size: 34rpx;
  font-weight: 500;
  margin-right: 20rpx;
}

.guest-count {
  font-size: 28rpx;
  color: #666;
}

.activity-tag {
  font-size: 26rpx;
  color: #444;
  background: #e6f7ff;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
}

.order-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx dashed #eee;
}

.phone-number {
  color: #666;
  font-family: monospace;
}

.call-btn {
  margin: 0 !important;
  font-size: 26rpx;
  background-color: #07c160;
  color: white;
  padding: 10rpx 30rpx;
  line-height: 1.5;
  border-radius: 10rpx;
}

.no-data {
  text-align: center;
  color: #999;
  margin-top: 100rpx;
}